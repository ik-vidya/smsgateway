# ============================================================================
# smsgateway configuration
# Copy to .env and adjust. Run with: smsgateway -config .env
# ============================================================================

# --- HTTP API ---
HTTP_ADDR=127.0.0.1:8080
# One key, or comma-separated list for multiple clients:
API_KEY=change-me-to-a-long-random-string
# API_KEYS=key1,key2,key3

# --- Modem ---
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
MODEM_CMD_TIMEOUT=5s
# Профиль модема: sim800 | quectel | telit | generic
# "generic" — только общие AT-команды, без специфичных обходов.
MODEM_PROFILE=generic
# Storage: ME или SM. Пусто — использовать значение по умолчанию профиля.
MODEM_STORAGE=
SMS_DELETE_AFTER_READ=true

# --- Storage ---
DB_PATH=./data/smsgateway.db
# Поддерживает суффиксы h, m, s, d. Примеры: 720h, 7d, 1d12h.
# Пусто = хранить вечно.
SMS_RETENTION=7d

# --- Gammu file backend (пусто = выключен) ---
FILES_BACKEND_DIR=
GAMMU_IMPORT_DIR=
GAMMU_IMPORT_INTERVAL=

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=text

# --- Self-test SMS ---
SELF_NUMBER=+37121234567
TEST_SMS_TIMEOUT=30s

# --- Telegram alerts (пусто = выключено) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Admin Web UI (по умолчанию выключен) ---
WEBUI_ENABLED=false
WEBUI_ADDR=127.0.0.1:8081
WEBUI_AUTH_MODE=none
WEBUI_OIDC_ISSUER=
WEBUI_OIDC_CLIENT_ID=
WEBUI_OIDC_CLIENT_SECRET=
WEBUI_OIDC_REDIRECT_URL=http://127.0.0.1:8081/auth/callback
WEBUI_OIDC_SCOPES=openid,profile,email
WEBUI_DEFAULT_LANG=en
WEBUI_SUPPORTED_LANGS=ru,lv,en
